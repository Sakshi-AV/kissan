{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/uploads/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/js/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/frontend/images/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/shop",
      "destination": "/frontend/shop.html"
    },
    {
      "source": "/cart",
      "destination": "/frontend/cart.html"
    },
    {
      "source": "/checkout",
      "destination": "/frontend/checkout.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/register",
      "destination": "/frontend/register.html"
    },
    {
      "source": "/farmer-dashboard",
      "destination": "/frontend/farmer-dashboard.html"
    },
    {
      "source": "/customer-dashboard",
      "destination": "/frontend/customer-dashboard.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/frontend/admin-dashboard.html"
    },
    {
      "source": "/product-details",
      "destination": "/frontend/product-details.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
